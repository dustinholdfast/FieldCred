# Copy to .env.local for local dev (node --env-file=.env.local server.mjs).
# In production, set these as your host's environment variables/secrets —
# never commit an actual .env.local, never put real values in this file.

# --- Stripe ---
# Test mode keys first (sk_test_... / whsec_...) — see README.md's
# "Stripe dashboard setup" section before going live.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JSON map of Stripe Price ID -> plan tier. Create your Prices in the
# Stripe dashboard first, then fill this in — must mirror what's actually
# enforced in supabase/schema.sql's plan_limits table.
PRICE_TIER_MAP_JSON={"price_REPLACE_ME":{"planTier":"growth","maxWorkers":50}}

# --- Supabase (Management API) ---
# supabase.com/dashboard/account/tokens — same rule as provision-tenant.mjs:
# never in a manifest, never committed, environment only.
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_ORG_ID=your-supabase-org-id
SUPABASE_REGION=us-east-2

# Path to the supabase/ tooling folder (provision-tenant.mjs lives there).
# Defaults to a sibling directory if unset — see provision.mjs.
SUPABASE_TOOLING_PATH=../supabase

# --- Billing service's own bookkeeping database ---
# NOT a tenant's database — see schema.sql. This connection string is as
# sensitive as SUPABASE_ACCESS_TOKEN (it holds every tenant's own DB
# connection string too, for the subscription webhook — see schema.sql's
# security note on tenant_billing.db_url).
BILLING_DB_URL=postgresql://...

# --- Email (Resend, same provider as the rest of the app) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=FieldCred <onboarding@fieldcred.co>
OPERATOR_ALERT_EMAIL=dustin@jinnivacations.com

# --- Misc ---
CANCELLATION_GRACE_DAYS=7
PORTAL_RETURN_URL=https://app.fieldcred.co/#/admin
PORT=3000
